# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFghijklmnop

# Full URL of the Google Spreadsheet
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1aBcDeFgHiJkLmNoPqRsTuVwXyZ/edit

# Sheet (tab) name inside the spreadsheet
GOOGLE_WORKSHEET_NAME=Sheet1

# Path to the Google Cloud service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Delay between messages in seconds (Telegram rate limit ~30 msg/sec)
DELAY_BETWEEN_MESSAGES=1

# HTTP request timeout in seconds
REQUEST_TIMEOUT=15

# Skip rows that already have Status = "sent"
SKIP_ALREADY_SENT=true

# Set to "true" to test without actually sending messages
DRY_RUN=false
