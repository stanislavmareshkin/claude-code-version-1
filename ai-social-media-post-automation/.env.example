# Make.com
MAKE_API_TOKEN=your_make_api_token
MAKE_ZONE=eu2

# AI Models
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AIza...

# Telegram (обязательно)
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-100XXXXXXXXXX

# VK (опционально)
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# VC.ru (опционально)
VC_API_TOKEN=
VC_SUBSITE_ID=

# Яндекс Дзен (опционально)
DZEN_API_TOKEN=

# --- Дополнительные сервисы (для отдельных сценариев) ---

# Perplexity AI (для сценариев VC и Дзен)
PERPLEXITY_API_KEY=

# UserAPI.ai / Midjourney (для генерации картинок)
USERAPI_AI_API_KEY=

# Placid (генерация обложек, для сценария VC)
PLACID_API_TOKEN=

# WordPress (для сценария Дзен через RSS)
WORDPRESS_URL=https://your-site.com
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# Google Sheets (ID таблицы с темами)
GOOGLE_SPREADSHEET_ID=

# Inoreader (для сценария VK)
INOREADER_APP_ID=
INOREADER_APP_KEY=

# --- Email SMTP (для холодной рассылки КП) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Your Name
EMAIL_REPLY_TO=
