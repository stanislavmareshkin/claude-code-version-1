{
  "name": "Холодная рассылка КП: Google Sheets → Claude → Email/Telegram → Трекинг",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:ActionSearchRows",
      "version": 4,
      "parameters": {
        "mode": "select"
      },
      "mapper": {
        "from": "drive",
        "sheetId": "{{ifempty(variables.GOOGLE_SPREADSHEET_ID; \"\")}}",
        "sheetName": "Лиды",
        "tableFirstRow": "A1:J1",
        "filter": [
          {
            "a": "{{H}}",
            "b": "new",
            "o": "text:equal"
          }
        ],
        "sortOrder": "asc",
        "sortBy": "{{A}}",
        "limit": "{{ifempty(variables.BATCH_SIZE; 10)}}"
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {},
        "expect": [
          { "name": "A", "type": "text", "label": "company" },
          { "name": "B", "type": "text", "label": "contact_name" },
          { "name": "C", "type": "text", "label": "email" },
          { "name": "D", "type": "text", "label": "industry" },
          { "name": "E", "type": "text", "label": "website" },
          { "name": "F", "type": "text", "label": "phone" },
          { "name": "G", "type": "text", "label": "telegram" },
          { "name": "H", "type": "text", "label": "status" },
          { "name": "I", "type": "text", "label": "last_sent_date" },
          { "name": "J", "type": "text", "label": "notes" }
        ],
        "label": "Google Sheets — читаем лиды (status=new)"
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "post",
        "headers": [
          { "name": "x-api-key", "value": "{{ifempty(variables.ANTHROPIC_API_KEY; \"\")}}" },
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\"model\": \"claude-sonnet-4-5-20241022\", \"max_tokens\": 1500, \"temperature\": 0.7, \"system\": \"Ты — эксперт по B2B-продажам и AI-автоматизации. Пиши кратко, персонализированно, без воды. Язык: русский.\\n\\nНаши услуги: {{ifempty(variables.OUR_SERVICES; \\\"AI-автоматизация маркетинга, чат-боты, автопостинг в соцсетях, аналитика, генерация контента\\\")}}\\n\\nФормат ответа — строго JSON без markdown-обёрток (без ```json):\\n{\\n  \\\"subject\\\": \\\"тема письма (до 78 символов, персонализированная)\\\",\\n  \\\"body_text\\\": \\\"тело письма (150-300 слов, с конкретной пользой для компании)\\\",\\n  \\\"body_html\\\": \\\"тело письма в HTML формате (с <p>, <b>, <ul> тегами)\\\"\\n}\", \"messages\": [{\"role\": \"user\", \"content\": \"Составь персонализированное коммерческое предложение.\\nИмя контакта: {{1.B}}\\nКомпания: {{1.A}}\\nОтрасль: {{ifempty(1.D; \\\"бизнес\\\")}}\\nСайт компании: {{ifempty(1.E; \\\"не указан\\\")}}\\nДополнительные заметки: {{ifempty(1.J; \\\"нет\\\")}}\\n\\nОтвечай ТОЛЬКО валидным JSON.\"}]}",
        "parseResponse": true,
        "shareCookies": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "metadata": {
        "designer": { "x": 350, "y": 0 },
        "restore": {},
        "expect": [],
        "parameters": [],
        "label": "Claude — генерация КП"
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.data}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": {},
        "expect": [
          { "name": "content", "type": "array" }
        ],
        "label": "Parse Claude Response"
      }
    },
    {
      "id": 4,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{3.content[].text}}"
      },
      "metadata": {
        "designer": { "x": 800, "y": 0 },
        "restore": {},
        "expect": [
          { "name": "subject", "type": "text" },
          { "name": "body_text", "type": "text" },
          { "name": "body_html", "type": "text" }
        ],
        "label": "Parse Proposal JSON"
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 1050, "y": 0 }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 6,
              "module": "email:ActionSendEmail",
              "version": 3,
              "parameters": {
                "account": "__PLACEHOLDER__"
              },
              "mapper": {
                "to": [
                  { "name": "{{1.B}}", "address": "{{1.C}}" }
                ],
                "subject": "{{4.subject}}",
                "content": "{{4.body_html}}",
                "contentType": "html",
                "replyTo": "{{ifempty(variables.EMAIL_REPLY_TO; \"\")}}",
                "fromName": "{{ifempty(variables.EMAIL_FROM_NAME; \"\")}}"
              },
              "metadata": {
                "designer": { "x": 1350, "y": -200 },
                "restore": {},
                "expect": [],
                "label": "Email — отправка КП"
              },
              "filter": {
                "name": "Есть email",
                "conditions": [
                  [
                    {
                      "a": "{{1.C}}",
                      "b": "",
                      "o": "text:notequal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 8,
              "module": "google-sheets:ActionUpdateRow",
              "version": 4,
              "parameters": {},
              "mapper": {
                "from": "drive",
                "sheetId": "{{ifempty(variables.GOOGLE_SPREADSHEET_ID; \"\")}}",
                "sheetName": "Лиды",
                "rowNumber": "{{1.__ROW_NUMBER__}}",
                "values": {
                  "H": "proposal_sent",
                  "I": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}"
                }
              },
              "metadata": {
                "designer": { "x": 1650, "y": -200 },
                "restore": {},
                "expect": [],
                "label": "Google Sheets — обновляем статус (email)"
              }
            }
          ],
          "label": "Email канал"
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.telegram.org/bot{{ifempty(variables.TELEGRAM_BOT_TOKEN; \"\")}}/sendMessage",
                "method": "post",
                "headers": [
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "body": "{\"chat_id\": \"{{1.G}}\", \"text\": \"*{{4.subject}}*\\n\\n{{4.body_text}}\", \"parse_mode\": \"Markdown\"}",
                "parseResponse": false,
                "shareCookies": false,
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
              },
              "metadata": {
                "designer": { "x": 1350, "y": 200 },
                "restore": {},
                "expect": [],
                "label": "Telegram — отправка КП"
              },
              "filter": {
                "name": "Есть Telegram ID и нет email",
                "conditions": [
                  [
                    {
                      "a": "{{1.G}}",
                      "b": "",
                      "o": "text:notequal"
                    },
                    {
                      "a": "{{1.C}}",
                      "b": "",
                      "o": "text:equal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 9,
              "module": "google-sheets:ActionUpdateRow",
              "version": 4,
              "parameters": {},
              "mapper": {
                "from": "drive",
                "sheetId": "{{ifempty(variables.GOOGLE_SPREADSHEET_ID; \"\")}}",
                "sheetName": "Лиды",
                "rowNumber": "{{1.__ROW_NUMBER__}}",
                "values": {
                  "H": "proposal_sent",
                  "I": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}"
                }
              },
              "metadata": {
                "designer": { "x": 1650, "y": 200 },
                "restore": {},
                "expect": [],
                "label": "Google Sheets — обновляем статус (telegram)"
              }
            }
          ],
          "label": "Telegram канал"
        }
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu2.make.com",
    "notes": "Холодная рассылка КП через AI.\n\nПайплайн:\n1. Читаем лиды из Google Sheets (status=new)\n2. Claude генерирует персонализированное КП для каждого лида\n3. Роутер отправляет по Email (приоритет) или Telegram\n4. Обновляем статус в Google Sheets → proposal_sent\n\nСтруктура таблицы Google Sheets (лист 'Лиды'):\n  A: company\n  B: contact_name\n  C: email\n  D: industry\n  E: website\n  F: phone\n  G: telegram (ID или @username)\n  H: status (new → proposal_sent → replied → deal / rejected)\n  I: last_sent_date\n  J: notes\n\nНеобходимые переменные сценария:\n- ANTHROPIC_API_KEY: ключ Anthropic API\n- GOOGLE_SPREADSHEET_ID: ID таблицы Google Sheets с лидами\n- TELEGRAM_BOT_TOKEN: токен бота (для Telegram-канала отправки)\n- EMAIL_FROM_NAME: имя отправителя\n- EMAIL_REPLY_TO: email для ответов\n- OUR_SERVICES: описание ваших услуг (для промпта Claude)\n- BATCH_SIZE: сколько лидов обрабатывать за запуск (по умолчанию 10)\n\nОпционально:\n- Подключите Email модуль (Gmail / SMTP / SendGrid) в блоке #6\n- Настройте триггер: вручную / по расписанию (каждый день в 10:00)\n- Добавьте второй сценарий для follow-up (фильтр status=proposal_sent, дата > 3 дней)"
  }
}
